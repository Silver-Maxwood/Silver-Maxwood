# Copy this file to .env.local and fill in your Supabase project details.
# Find these under Project Settings -> API in your Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used by server-side scripts (e.g. scripts/seed.ts). Never expose this
# to the browser / never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
